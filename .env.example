# --- LLM via the Respan gateway (key handed out at kickoff) -------------------
LLM_PROVIDER=custom
LLM_ENDPOINT=https://api.respan.ai/api
LLM_API_KEY=<respan-key>
LLM_MODEL=openai/gpt-5-mini

EMBEDDING_PROVIDER=custom
EMBEDDING_ENDPOINT=https://api.respan.ai/api
EMBEDDING_API_KEY=<same-respan-key>
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Agent code (OpenAI SDK pointed at the gateway)
RESPAN_API_KEY=<respan-key>
AGENT_MODEL=gpt-5-mini

# --- Scalekit AgentKit (Dashboard -> Developers -> API Credentials) ----------
# Connections to create under AgentKit -> Connections: slack, github, notion
SCALEKIT_ENVIRONMENT_URL=https://<env>.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=...
# Connection names exactly as shown under AgentKit -> Connections
GITHUB_CONNECTION_NAME=github-connect
SLACK_CONNECTION_NAME=slack-ccx1Q8Vg
NOTION_CONNECTION_NAME=notion-8L4CahkP
# Scalekit identifier per user (default: the demo email in src/brain/users.py)
# SCALEKIT_ID_MARC=<email used when Marc authorized the connections>
# SCALEKIT_ID_THOMAS=<email used when Thomas authorized the connections>

# What to pull
SLACK_ALERT_CHANNEL=#alertes-maintenance
GITHUB_OWNER=tdenizot
GITHUB_REPOS=company-brain-hackathon

# --- Cognee -----------------------------------------------------------------
ENABLE_BACKEND_ACCESS_CONTROL=true
